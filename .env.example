# Copy this file to .env and fill in values as needed.
# The app runs perfectly well with NONE of these set (offline mode +
# synthetic data + default hyperparameters) -- they're all optional tuning.

# --- Talk-to-Data (optional) ---
# Leave blank to run the Talk-to-Data tab in offline verified-query-library
# mode. Set it to enable live natural-language-to-SQL via Claude.
GOOGLE_API_KEY=

# Which Claude model to use for NL-to-SQL generation.
LLM_MODEL=gemini-2.5-flash

# --- Data (optional) ---
# Directory to look for the dataset file in (mounted as a volume in Docker).
DATA_DIR=data
# Expected filename of the real Kaggle dataset. If not found in DATA_DIR, a
# schema-matched synthetic dataset is generated automatically.
DATASET_FILENAME=application_train.csv
# Row count for the synthetic fallback dataset.
SYNTHETIC_ROWS=15000

# --- Model artifacts (optional) ---
MODELS_DIR=models

# --- ML behavior (optional) ---
RANDOM_SEED=42
# How many times costlier a missed defaulter (false negative) is assumed to
# be than an unnecessarily rejected good applicant (false positive), used to
# pick the cost-optimal decision threshold instead of an arbitrary 0.5 cutoff.
FN_COST_MULTIPLIER=10

# --- Logging (optional) ---
LOG_LEVEL=INFO
